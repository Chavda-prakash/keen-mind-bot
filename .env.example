# Supabase Configuration (Public/Anon keys are safe, use project-specific values)
SUPABASE_PROJECT_ID=your_project_id_here
SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PROJECT_ID=your_project_id_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
VITE_SUPABASE_URL=https://your-project.supabase.co

# LLM Providers (optional - at least one recommended)
# Lovable AI
LOVABLE_API_KEY=your_lovable_api_key_here

# Local LLM Mode (uses Ollama)
AGENT_LOCAL_MODE=0
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Search Providers (optional - defaults to DuckDuckGo)
TAVILY_API_KEY=your_tavily_api_key_here
BRAVE_SEARCH_API_KEY=your_brave_search_key_here

# Model Configuration (optional - uses defaults if not set)
MODEL_FAST=google/gemini-3.1-flash-lite
MODEL_REASONING=google/gemini-3.6-flash
MODEL_EXTRACT=google/gemini-3.1-flash-lite
MODEL_EMBED=google/gemini-embedding-001

# Agent Limits (optional)
AGENT_MAX_QUERIES=5
AGENT_MAX_SOURCES_PER_QUERY=8
AGENT_MAX_PAGES=8
AGENT_MAX_LOOPS=2
AGENT_FETCH_TIMEOUT_MS=12000
AGENT_TOOL_TIMEOUT_MS=30000
AGENT_TOOL_RETRIES=2
AGENT_MAX_EXTRACT_CHARS=12000

# Provider Order (optional - comma-separated)
LLM_PROVIDER_ORDER=lovable,ollama
SEARCH_PROVIDER_ORDER=tavily,brave,duckduckgo
EMBEDDINGS_PROVIDER_ORDER=lovable,ollama

# Features (optional)
ENABLE_BROWSER_AUTOMATION=0
ENABLE_MULTI_MODEL_COMPARE=1

# n8n Integration (optional)
N8N_WEBHOOK_URL=

# Copy this file to .env and fill in your actual credentials
